    {
        "id": "52b626136cd43158",
        "type": "function",
        "z": "271795122c85cdbb",
        "name": "Atualiza Status dos Alarmes",
        "func": "let status = flow.get(\"alarm_status\") || { temperatura: \"ok\" };\n\nif (msg.payload.alarme === \"temperatura\") {\n    status.temperatura = msg.payload.status;\n}\n\nflow.set(\"alarm_status\", status);\n\nlet temp_html = (status.temperatura === 'ok') ?\n    '<font color=\"green\">OK</font>' :\n    '<font color=\"red\"><b>ALARME ATIVO</b></font>';\n\nmsg.payload = `\n<div style=\"line-height: 2.5; font-size: 16px;\">\n    <div>🌡️ Temperatura: ${temp_html}</div>\n</div>\n`;\n\nreturn msg;\n",
