    {
        "id": "d26a81607e1252be",
        "type": "function",
        "z": "271795122c85cdbb",
        "name": "Formata Log de Temperatura",
        "func": "// Pega o histórico de temperatura anterior. Usa uma variável diferente ('temp_log').\nvar historico = flow.get('temp_log') || \"\";\n\n// Pega a hora atual.\nlet d = new Date();\nlet time = d.toLocaleTimeString('pt-BR');\n\n// Formata a nova linha do log com a unidade \"°C\".\nlet nova_linha = time + \" - Temp: \" + msg.payload + \" °C\";\n\n// Adiciona a nova linha NO INÍCIO do histórico.\nhistorico = nova_linha + \"\\n\" + historico;\n\n// Limita o histórico às últimas 20 entradas, por exemplo.\nvar linhas = historico.split(\"\\n\");\nif (linhas.length > 20) {\n    linhas.pop();\n    historico = linhas.join(\"\\n\");\n}\n\n// Guarda o novo histórico na memória.\nflow.set('temp_log', historico);\n\n// Envia o histórico COMPLETO para ser exibido.\nmsg.payload = historico;\nreturn msg;",
